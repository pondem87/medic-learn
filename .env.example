DJANGO_SECRET_KEY=replace-with-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://medic:medic-local@127.0.0.1:55432/medic
RABBITMQ_URL=amqp://medic:medic-local@127.0.0.1:5673/%2F
POSTGRES_PASSWORD=medic-local
RABBITMQ_PASSWORD=medic-local
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
WHATSAPP_ENABLED=False

AWS_REGION=af-south-1
COGNITO_POOL_ID=
COGNITO_WEB_CLIENT_ID=
COGNITO_WEB_CLIENT_SECRET=
COGNITO_MOBILE_CLIENT_ID=
COGNITO_SESSION_KEY=
# Blank uses private local storage in development; production requires the bucket.
EVIDENCE_BUCKET=

